# ── Base de datos ─────────────────────────────────────────────
# Postgres. La fuente de verdad del contenido: el panel de /admin
# escribe aquí y el sitio lee de aquí.
#
# EN PRODUCCIÓN usa la cadena del POOLER de Supabase — la que lleva
# "pooler.supabase.com:6543" y el usuario "postgres.<ref>". Es la que
# aguanta muchas instancias serverless; la conexión directa
# ("db.<ref>.supabase.co:5432") agota el límite de conexiones en Vercel.
#
# Para CREAR EL ESQUEMA hace falta la directa: el pooler en modo
# transacción no admite las sentencias DDL que ejecuta la semilla.
#
# EN LOCAL, con Docker:
#   npm run db:local
#   DATABASE_URL="postgresql://postgres:portafolio@localhost:5432/portafolio"
#
# Después, en cualquiera de los dos casos:
#   npm run db:seed
DATABASE_URL=""

# ── URL pública ───────────────────────────────────────────────
# Sin esto, los enlaces canónicos, el sitemap y la imagen de
# previsualización apuntan al dominio por defecto.
NEXT_PUBLIC_SITE_URL="https://gustavomarquez.dev"

# ── Formulario de contacto (Resend) ───────────────────────────
# Si faltan, el formulario sigue funcionando: ofrece enviar el
# mensaje por el cliente de correo del visitante.
#
# 1. Crea una cuenta en https://resend.com
# 2. Verifica tu dominio (o usa onboarding@resend.dev para probar)
# 3. Copia la API key aquí y en Vercel → Settings → Environment Variables
RESEND_API_KEY=""
RESEND_FROM="Portafolio <contacto@gustavomarquez.dev>"

# ── Panel de administración (/admin) ──────────────────────────
# Sólo se usa la PRIMERA vez, al sembrar: se guarda como hash scrypt
# en la tabla "admin" y a partir de ahí la fuente de verdad es la base.
# Cambiarla aquí después no cambia la contraseña del panel.
ADMIN_PASSWORD=""

# Secreto para firmar la cookie de sesión del panel. Sin él, el panel
# no deja entrar: es preferible a dejar entrar a cualquiera.
# Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=""
