# ═══════════════════════════════════════════════════════════════
#  El repositorio se despliega DOS VECES desde la misma rama.
#  Lo que cambia entre las dos es este archivo.
#
#    FRONT    el sitio público. SUPERFICIE=front (o sin poner).
#             DATABASE_URL con el rol de SÓLO LECTURA.
#             /admin devuelve 404.
#
#    BACKEND  el panel. SUPERFICIE=backend.
#             DATABASE_URL con el rol completo. Sin indexar.
#
#  Se separan porque tienen amenazas distintas: el front lo visita
#  cualquiera y sólo necesita leer; el panel lo visita una persona y
#  necesita escribirlo todo. Juntos, el sitio público cargaría con
#  credenciales de escritura que nunca usa.
# ═══════════════════════════════════════════════════════════════

# ── Qué superficie es este despliegue ─────────────────────────
# "front" o "backend". Si falta se asume "front": desplegar sin
# configurar nada da el sitio público sin panel, nunca un panel
# abierto por descuido.
SUPERFICIE="front"

# ── Base de datos ─────────────────────────────────────────────
# Postgres. La fuente de verdad del contenido: el panel escribe aquí
# y el sitio lee de aquí.
#
# USA SIEMPRE LA CADENA DEL POOLER — la de "pooler.supabase.com:6543",
# con el usuario "<rol>.<ref-del-proyecto>". Es la que aguanta muchas
# instancias serverless; la conexión directa
# ("db.<ref>.supabase.co:5432") agota el límite de conexiones.
#
#   FRONT    postgresql://portafolio_lector.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   BACKEND  postgresql://postgres.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# El rol de sólo lectura se crea una vez con src/db/roles.sql.
#
# Para CREAR EL ESQUEMA hace falta la conexión DIRECTA: el pooler en
# modo transacción no admite la DDL que ejecuta la semilla.
#
# EN LOCAL, con Docker:
#   npm run db:local
#   DATABASE_URL="postgresql://postgres:portafolio@localhost:5432/portafolio"
#
# Después, en cualquiera de los dos casos:
#   npm run db:seed
DATABASE_URL=""

# ── URL pública ───────────────────────────────────────────────
# Sin esto, los enlaces canónicos, el sitemap y la imagen de
# previsualización apuntan al dominio por defecto. En el backend da
# igual: no se indexa.
NEXT_PUBLIC_SITE_URL="https://gustavo-portfolio2026.vercel.app"

# ── Formulario de contacto (Resend) ───────────────────────────
# Sólo en el FRONT. Si faltan, el mensaje se guarda igual en la base
# y aparece en la pestaña «Mensajes» del panel: el aviso por correo
# es una comodidad, no el sitio donde vive el mensaje.
#
# 1. Crea una cuenta en https://resend.com
# 2. Verifica tu dominio (o usa onboarding@resend.dev para probar)
# 3. Copia la API key aquí y en Vercel → Settings → Environment Variables
RESEND_API_KEY=""
RESEND_FROM="Portafolio <contacto@gustavomarquez.dev>"

# ── Acceso al panel ───────────────────────────────────────────
# Sólo hacen falta en el BACKEND.
#
# Correo y contraseña se guardan en la tabla `admin` (la contraseña
# como hash scrypt) y a partir de ahí la fuente de verdad es la base:
# cambiarlos aquí después no cambia el acceso. Para forzarlo:
#
#   npx tsx --env-file=.env.local scripts/credenciales.ts <correo> <clave>
#
# Si ADMIN_EMAIL falta, la semilla usa el correo del perfil.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Secreto para firmar la cookie de sesión del panel. Sin él, el panel
# no deja entrar: es preferible a dejar entrar a cualquiera.
# Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=""
